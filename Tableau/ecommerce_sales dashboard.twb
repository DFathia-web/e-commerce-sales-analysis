      <aliases enabled='yes' />
      <column caption='full refund rate ' datatype='real' default-format='p0.00%' name='[ refund rate (copy)_559853775892963336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;refunded&quot; THEN [order_id] END)/ COUNTD([order_id])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[ctd:order_id:qk]&quot;' value='Total Orders' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr: refund rate (copy)_559853775892963336:qk]&quot;' value='Full refund rate ' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr:Calculation_199847280777797634:qk]&quot;' value='Repeat customer rate' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr:Calculation_199847280798715909:qk]&quot;' value='Unique customer rate' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr:Calculation_559853775874199552:qk]&quot;' value='Partial refund rate' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr:Calculation_559853775885324291:qk]&quot;' value='Average order value' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr:Calculation_96545964902592513:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.1bhesjk0iu18jz135z9sz1lm98tt].[usr:full refund rate  (copy)_559853775934623761:qk]&quot;' value='Cancelled rate  ' />
        </aliases>
      </column>
      <column caption='repeat cust rate' datatype='real' default-format='p0.00%' name='[Calculation_199847280777797634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_559853775894126601] THEN [customer_id] END) / COUNTD([customer_id])' />
      </column>
      <column caption='unique customer count' datatype='integer' name='[Calculation_199847280797913092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_199847280799338502] THEN [customer_id] END)' />
      </column>
      <column caption='unique cust. rate' datatype='real' default-format='p0.00%' name='[Calculation_199847280798715909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_199847280799338502] THEN [customer_id] END) / COUNTD([customer_id])' />
      </column>
      <column caption='unique customers' datatype='boolean' name='[Calculation_199847280799338502]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : COUNTD([order_id]) } &gt;=1' />
      </column>
      <column caption='partial refund rate' datatype='real' default-format='p0.00%' name='[Calculation_559853775874199552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF[order_status] = &quot;partially_refunded&quot; THEN [order_id] END)/ COUNTD([order_id])' />
      </column>
      <column caption='average order value' datatype='real' name='[Calculation_559853775885324291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_revenue]) / COUNT([order_id])' />
      </column>
      <column caption='repeat customers' datatype='boolean' name='[Calculation_559853775894126601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : COUNTD([order_id]) } &gt;1' />
      </column>
      <column caption='repeat cust. count' datatype='integer' name='[Calculation_559853775894609930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_559853775894126601] THEN [customer_id] END)' />
      </column>
      <column caption='Count of Orders' datatype='integer' name='[Calculation_96545964902592513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Sales YoY ' datatype='real' name='[Calculation_96545964906987524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF YEAR([date]) = YEAR({MAX([date])}) AND&#13;&#10;&#13;&#10;[date] &lt;= {MAX([date])} THEN [net_revenue] END)&#13;&#10;-&#13;&#10;SUM(IF YEAR([date]) = YEAR({MAX([date])})-1 AND&#13;&#10;[date] &lt;= DATEADD(&apos;year&apos;,-1,{MAX([date])}) THEN [net_revenue] END))&#13;&#10;/&#13;&#10;SUM(IF YEAR([date]) = YEAR({MAX([date])})-1 AND&#13;&#10;[date] &lt;= DATEADD(&apos;year&apos;,-1,{MAX([date])}) THEN [net_revenue] END)&#13;&#10;&#13;&#10;// Using TODAY()&#13;&#10;//(SUM(IF YEAR([Date]) = YEAR(TODAY()) AND [Date] &lt;= TODAY() THEN [Net Revenue] END) -&#13;&#10;//SUM(IF YEAR([Date]) = YEAR(TODAY())-1 AND [Date] &lt;= DATEADD(&apos;year&apos;,-1,TODAY()) THEN [Net Revenue] END))/&#13;&#10;&#13;&#10;//SUM(IF YEAR([Date]) = YEAR(TODAY())-1 AND [Date] &lt;= DATEADD(&apos;year&apos;,-1,TODAY()) THEN [Net Revenue] END)' />
      </column>
      <column caption='Net Revenue YoY Display' datatype='string' name='[Calculation_96545964910800903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([net_revenue]*100, 1) &gt; 0 THEN &quot; increase in sales (YoY YTD)&quot;&#13;&#10;&#13;&#10;ELSEIF ROUND([net_revenue]*100, 1) &lt; 0 THEN &quot; decrease in sales (YoY YTD)&quot;&#13;&#10;&#13;&#10;ELSE &quot; - No change&quot; END' />
      </column>
      <column caption='one-time customers' datatype='boolean' name='[Calculation_96545964925468698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : COUNTD([order_id]) } =1' />
      </column>
      <column caption='Net Revenue YoY' datatype='real' name='[Calculation_96545964928221211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [date] ={MAX([date])} THEN [net_revenue] END)) - (SUM(IF [date] ={MAX([date])}-1 THEN [net_revenue] END))&#13;&#10;/(SUM(IF [date] ={MAX([date])}-1 THEN [net_revenue] END))' />
      </column>
